{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "AGENT_NAME=claude $CLAUDE_PROJECT_DIR/.agents/hooks/test_probe.sh PreToolUse",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.agents/hooks/redirect_gh_issue.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "AGENT_NAME=claude $CLAUDE_PROJECT_DIR/.agents/hooks/test_probe.sh UserPromptSubmit",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
