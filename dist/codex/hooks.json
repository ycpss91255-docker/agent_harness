{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)/.agents/hooks/redirect_gh_issue.sh\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)/.agents/hooks/tag_assisted_commit.sh\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
